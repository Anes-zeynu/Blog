<section class="articles">
  <h2 class="article_heading">Latest Posts</h2>

  <ul class="article-ul">
    <% data.forEach(element => { %>
      <li>
        <a href="/post/<%= element._id %>">
          <span><%= element.title %></span>
          <span class="article-list-days">
            <%= element.createdDate.toDateString() %>
          </span>
        </a>
      </li>
    <% }) %>
  </ul>

  <% if (nextPage !== null) { %>
    <a href="/?page=<%= nextPage %>" class="pagination">
      &lt; View Older Posts
    </a>
  <% } %>
</section>