
<%
  const totalPosts = (typeof data !== "undefined" && data.totalPosts !== undefined)
    ? data.totalPosts
    : 0;

  const adminName = (typeof admin !== "undefined" && admin && admin.username)
    ? admin.username
    : "Administrator";
%>

<div class="dashboard-wrapper">

  <!-- SIDEBAR -->
  <aside class="dashboard-sidebar">

    <div class="sidebar-brand">
      <div class="sidebar-logo">B</div>
      <span>Blog Admin</span>
    </div>

    <div class="sidebar-profile">
      <div class="profile-avatar">
        <%= adminName.charAt(0).toUpperCase() %>
      </div>

      <div>
        <h4><%= adminName %></h4>
        <small>Administrator</small>
      </div>
    </div>

    <nav class="sidebar-nav" aria-label="Admin navigation">

      <p class="sidebar-label">MENU</p>

      <a href="/dashboard" class="sidebar-link active">
        <span>▦</span>
        Dashboard
      </a>

      <a href="/posts/create" class="sidebar-link">
        <span>＋</span>
        Create Post
      </a>

      <a href="/admin/posts" class="sidebar-link">
        <span>▤</span>
        All Posts
      </a>

      <p class="sidebar-label">GENERAL</p>

      <a href="/" class="sidebar-link">
        <span>⌂</span>
        View Website
      </a>

    </nav>

    <div class="sidebar-bottom">
      <form action="/admin/logout" method="POST">
        <button type="submit" class="logout-button">
          <span>↪</span>
          Logout
        </button>
      </form>
    </div>

  </aside>


  <!-- MAIN DASHBOARD -->
  <main class="dashboard-main">

    <!-- HEADER -->
    <header class="dashboard-topbar">

      <div>
        <h1>Dashboard</h1>
        <p>Welcome back, <%= adminName %>!</p>
      </div>

      <a href="/" class="website-button">
        View Website ↗
      </a>

    </header>


    <!-- OVERVIEW -->
    <section class="dashboard-overview">

      <div class="overview-heading">

        <div>
          <h2>Overview</h2>
          <p>Here's what's happening with your blog.</p>
        </div>

        <a href="/posts/create" class="create-post-button">
          + Create New Post
        </a>

      </div>


      <!-- STATISTICS -->
      <div class="dashboard-stats">

        <div class="dashboard-stat-card">
          <div class="stat-icon purple">▤</div>

          <div>
            <p>Total Posts</p>
            <h2><%= totalPosts %></h2>
          </div>
        </div>

        <div class="dashboard-stat-card">
          <div class="stat-icon blue">✎</div>

          <div>
            <p>Administrator</p>
            <h2>Active</h2>
          </div>
        </div>

        <div class="dashboard-stat-card">
          <div class="stat-icon green">✓</div>

          <div>
            <p>Account Status</p>
            <h2 class="active-status">Active</h2>
          </div>
        </div>

      </div>

    </section>


    <!-- WELCOME SECTION -->
    <section class="dashboard-posts">

      <div class="posts-heading">
        <div>
          <h2>Welcome to Your Blog Admin Panel</h2>
          <p>
            Manage your blog content, create articles,
            and control your website from here.
          </p>
        </div>
      </div>

      <div class="empty-posts">

        <div class="empty-icon">▤</div>

        <h3>Manage Your Blog</h3>

        <p>
          Use the sidebar to create new posts or manage
          your existing blog articles.
        </p>

        <a href="/admin/posts" class="create-post-button">
          View All Posts
        </a>

      </div>

    </section>


    <!-- FOOTER -->
    <footer class="dashboard-footer">
      <p>
        Blog Administration Panel &copy;
        <%= new Date().getFullYear() %>
      </p>
    </footer>

  </main>

</div>
