<div class="admin-page">
   <div class="admin-page-header">

    <div>
      <h1>Manage Posts</h1>
      <p>View and manage all your blog articles.</p>
    </div>
    <a href="/admin/posts/new" class="btn-primary">
      + Create New Post
    </a>
    </div>

    <div class="admin-card">

    <div class="admin-card-header">
      <h2>All Blog Posts</h2>

      <span>Total: <%= posts.length %></span>
    </div>

<% if (posts.length > 0) { %>

      <div class="table-responsive">

        <table class="admin-table">

          <thead>
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Created Date</th>
              <th>Updated Date</th>
              <th>Actions</th>
            </tr>
          </thead>


          <tbody>

            <% posts.forEach((post, index) => { %>

              <tr>

                <td><%= index + 1 %></td>

                <td>
                  <strong><%= post.title %></strong>
                </td>

                <td>
                  <%= new Date(post.createdDate).toLocaleDateString() %>
                </td>

                <td>
                  <%= new Date(post.updatedDate).toLocaleDateString() %>
                </td>

                <td class="action-buttons">

                  <a href="/admin/posts/edit/<%= post._id %>"
                     class="btn-edit">
                    Edit
                  </a>

                  <button class="btn-delete">
                    Delete
                  </button>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    
</div>