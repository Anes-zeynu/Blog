<div class="create-post-page">
  <div class="page-header">
    <h1>Create a new post</h1>
    <p>Write and publish a new blog article</p>
  </div>


  <form action="/admin/posts/create" method="POST" class="create-post-form">

    <div class="form-group">
      <label for="title">Post title</label>
      <input type="text" 
      placeholder="enter your blog title" 
      name="title" 
      id="title"
      required>
      <div class="form-group">
      <label for="body">Post contents</label>
      <textarea
      placeholder="write a blog contents here" 
      name="body" 
      id="body"
      row="15"
      required>
      </textarea>
      </div>

      <div class="form-actions">
        <a href="/admin/posts/create" class="cancel-btn">
          Cancel
        </a>

        <button type="submit" class="publish-btn">
          Publish Posts
        </button>
      </div>
    </div>
  </form>
</div>