<h1>Admin Registration</h1>

<form action="/admin/register" method="POST">

  <input
    type="text"
    name="username"
    placeholder="Username"
    required
  >

  <input
    type="email"
    name="email"
    placeholder="Email"
    required
  >

  <input
    type="password"
    name="password"
    placeholder="Password"
    required
  >

  <input
    type="password"
    name="setupKey"
    placeholder="Setup Key"
    required
  >

  <button type="submit">Register Admin</button>

</form>